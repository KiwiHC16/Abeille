{
    "plug.maeu01": {
        "manufacturer": "Xiaomi",
        "model": "SP-EUC01",
        "type": "Xiaomi Aqara EU smart plug",
        "genericType": "Outlet",
        "timeout": "60",
        "configuration": {
            "mainEP": "01",
            "icon": "Xiaomi-SmartPlug"
        },
        "category": {
            "automatism": "1",
            "energy": "1"
