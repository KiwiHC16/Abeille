{
    "MINI-ZBRBS_SONOFF": {
        "manufacturer": "Sonoff",
        "model": "MINI-ZBRBS",
        "type": "Sonoff roller shutter module",
        "genericType": "Shutter",
        "category": {
            "opening": "1"
        },
        "configuration": {
            "icon": "Sonoff-MINIZBRBS",
            "mainEP": "01"
        },
        "commands": {
            "Up": {
                "use": "act_zbCmdC-0102-UpOpen",
                "isVisible": "1"
            },
            "Stop": {
                "use": "act_zbCmdC-0102-Stop",
                "isVisible": "1"
            },
            "Down": {
                "use": "act_zbCmdC-0102-DownClose",
                "isVisible": "1",
                "nextLine": "after"
            },
            "Set level": {
                "use": "act_zbCmdC-0102-GoToLiftPercentage",
                "comment": "Verified 2026-07-05 on the physical device: slider=30 => Level reads back 30, so this inversion (ZCL 'CurrentPositionLiftPercentage' is 0=open/100=closed, inverted so slider/Level 100=open) is correct.",
                "valueOffset": "100-#slider#",
                "isVisible": "1"
            },
            "Level": {
                "use": "inf_zbAttr-0102-CurPosLiftPercent",
                "calculValueOffset": "100-#value#",
                "isVisible": "1",
                "nextLine": "after"
            },
            "Get Level": {
                "use": "act_zbReadAttribute",
                "params": "clustId=0102&attrId=0008"
            },
            "Bind 0102-ToZigate": {
                "use": "act_zbBindToZigate",
                "params": "clustId=0102",
                "execAtCreation": "yes"
            },
            "SetReporting 0102": {
                "use": "act_zbConfigureReporting2",
                "params": "clustId=0102&attrId=0008&attrType=20",
                "execAtCreation": "yes"
            },
            "Get Calibration Status": {
                "comment": "eWeLink/Sonoff proprietary cluster FC11 (manufId 1286), not standard ZCL. Source: zigbee-herdsman-converters src/devices/sonoff.ts (customClusterEwelink) and PR #11292.",
                "use": "act_zbReadAttribute",
                "params": "clustId=FC11&attrId=5012&attrType=20&manufId=1286",
                "execAtCreation": "yes"
            },
            "Calibration Status": {
                "use": "inf_generic-NumericBadge",
                "comment": "Enum meant to be 0=Uncalibrated/1=Calibrated (per PR), but reads 0 even after calibration was confirmed done (2026-07-05: Set level to a physical device already positions accurately). Likely a parsing/manufId issue reading this proprietary eWeLink attribute rather than an actual device state - do not trust this value.",
                "params": "clustId=FC11&attrId=5012&attrType=20&manufId=1286"
            },
            "Start Automatic Calibration": {
                "use": "act_zbWriteAttribute",
                "comment": "Writes motorTravelCalibrationAction=2 (start_automatic). Not yet verified on this specific device: values from the referenced PR are start_automatic=2, start_manual=3, clear=4, manual_2_fully_opened=7, manual_3_fully_closed=8.",
                "params": "clustId=FC11&attrId=5001&attrType=20&attrVal=02&manufId=1286"
            },
            "Get Motor Status": {
                "use": "act_zbReadAttribute",
                "params": "clustId=FC11&attrId=5013&attrType=20&manufId=1286"
            },
            "Motor Status": {
                "use": "inf_generic-NumericBadge",
                "comment": "0=Stop, 1=Forward, 2=Reverse (not yet verified)",
                "params": "clustId=FC11&attrId=5013&attrType=20&manufId=1286"
            }
        }
    }
}
